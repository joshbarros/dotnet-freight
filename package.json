{
  "name": "dotnet-freight",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "build": "nx run-many -t build -p api web",
    "docker:up": "docker compose up --build --detach --wait",
    "docker:down": "docker compose down",
    "format": "npm run format:web && npm run format:api",
    "format:check": "npm run format:web:check && npm run format:api:check",
    "format:web": "prettier --write \"apps/web/src/**/*.{ts,css,html}\" \"playwright.config.ts\" \"e2e/**/*.ts\"",
    "format:web:check": "prettier --check \"apps/web/src/**/*.{ts,css,html}\" \"playwright.config.ts\" \"e2e/**/*.ts\"",
    "format:api": "dotnet format whitespace Freight.sln --no-restore",
    "format:api:check": "dotnet format whitespace Freight.sln --no-restore --verify-no-changes",
    "smoke": "./scripts/smoke.sh",
    "test:e2e": "playwright test",
    "lint": "nx lint web",
    "typecheck": "nx typecheck web"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@nx/angular": "23.2.1",
    "@nx/dotnet": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.0",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.5",
    "nx": "23.2.1",
    "postcss": "^8.5.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "piscina": "5.3.2",
    "axios": "1.20.0",
    "smol-toml": "1.9.0",
    "brace-expansion@>=4.0.0": "5.0.12"
  }
}
